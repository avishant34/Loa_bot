# ==============================
# Law of Attraction Bot - Config
# ==============================
# cp .env.example .env
# Phir real values daalo. .env ko GitHub pe MAT push karna!

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ---------- AI Provider ----------
# Options: groq | openai | openrouter | together
AI_PROVIDER=groq

# Free (Groq) - https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Baad mein Paid (OpenAI)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxxxxxxx
# AI_MODEL=gpt-4o-mini

# ---------- Admin & Payments ----------
# Apna Telegram User ID (bot ko /myid bhej ke pata karo)
# Multiple admins: 123456789,987654321
ADMIN_IDS=123456789

# UPI details (premium payments ke liye)
UPI_ID=yourname@upi
UPI_NAME=LoA Bot Premium
